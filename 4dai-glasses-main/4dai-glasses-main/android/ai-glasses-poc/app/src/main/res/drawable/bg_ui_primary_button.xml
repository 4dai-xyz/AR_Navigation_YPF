<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#136B73"
                android:startColor="#197F88" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#240E5D65" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#177D88"
                android:startColor="#1EA1A3" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#1A0C5A62" />
        </shape>
    </item>
</selector>
