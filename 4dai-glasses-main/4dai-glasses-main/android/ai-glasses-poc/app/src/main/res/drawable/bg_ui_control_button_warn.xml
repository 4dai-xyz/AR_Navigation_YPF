<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#FFF9ECDD"
                android:startColor="#FFFFFBF4" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#44E2A05B" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#FFFEF4E8"
                android:startColor="#FFFFFDFA" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#3EE7A463" />
        </shape>
    </item>
</selector>
