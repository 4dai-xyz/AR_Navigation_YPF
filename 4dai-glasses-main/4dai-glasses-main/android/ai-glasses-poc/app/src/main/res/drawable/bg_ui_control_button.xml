<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#FFF4ECE2"
                android:startColor="#FFFBF7F0" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#2EDAE1E8" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#FFF9F4ED"
                android:startColor="#FFFFFEFD" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#26DCE2E9" />
        </shape>
    </item>
</selector>
