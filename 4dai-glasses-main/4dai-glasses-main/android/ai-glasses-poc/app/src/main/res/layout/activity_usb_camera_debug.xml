<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F5F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonBack"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ui_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_back"
                android:textColor="#374151"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/title_usb_camera_debug"
                android:textColor="#111827"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textUsbCameraPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#374151"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textUsbDeviceSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ui_subpanel"
            android:padding="12dp"
            android:textColor="#374151"
            android:textSize="12sp" />

        <android.view.TextureView
            android:id="@+id/viewUsbCameraPreview"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/textUsbCameraStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ui_status_capsule"
            android:padding="12dp"
            android:text="@string/text_usb_camera_idle"
            android:textColor="#374151"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerUsbCamera"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonRequestPermission"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_request_permission"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/buttonRefreshUsbCamera"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_refresh_usb_camera"
                android:textColor="#374151"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/buttonToggleUsbSettings"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ui_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/action_show_usb_camera_settings"
            android:textColor="#374151"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutUsbSettingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ui_subpanel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/title_usb_camera_settings"
                android:textColor="#111827"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textUsbSettingsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_ui_status_capsule"
                android:padding="10dp"
                android:text="@string/text_usb_camera_settings_hint"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_usb_video_format"
                android:textColor="#374151"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerUsbVideoFormat"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_usb_photo_quality"
                android:textColor="#374151"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editUsbPhotoQuality"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_ui_status_capsule"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#111827"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_usb_video_fps"
                        android:textColor="#374151"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editUsbVideoFrameRate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_ui_status_capsule"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_usb_video_bitrate"
                        android:textColor="#374151"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editUsbVideoBitRate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_ui_status_capsule"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_usb_video_iframe"
                        android:textColor="#374151"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editUsbIFrameInterval"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_ui_status_capsule"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkUsbRecordAudio"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/label_usb_record_audio"
                    android:textColor="#374151"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutUsbAudioSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_usb_audio_settings"
                    android:textColor="#374151"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editUsbAudioBitRate"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ui_status_capsule"
                        android:hint="@string/hint_usb_audio_bitrate"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/editUsbAudioSampleRate"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ui_status_capsule"
                        android:hint="@string/hint_usb_audio_samplerate"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editUsbAudioChannels"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ui_status_capsule"
                        android:hint="@string/hint_usb_audio_channels"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/editUsbAudioMinBuffer"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ui_status_capsule"
                        android:hint="@string/hint_usb_audio_min_buffer"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutUsbImageControlPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="图像参数"
                    android:textColor="#374151"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textUsbImageControlSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_ui_status_capsule"
                    android:padding="10dp"
                    android:text="打开 USB 摄像头后显示白平衡、曝光、亮度等设备支持项。"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/layoutUsbImageControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonApplyUsbSettings"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ui_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/action_apply_usb_settings"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/buttonResetUsbSettings"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ui_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/action_reset_usb_settings"
                    android:textColor="#374151"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonOpenUsbCamera"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_open_usb_camera"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/buttonCaptureUsbPhoto"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_capture_usb_photo"
                android:textColor="#374151"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonStartUsbVideo"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_start_usb_video"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/buttonStopUsbVideo"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_stop_usb_video"
                android:textColor="#374151"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ui_subpanel"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/title_usb_camera_album"
                    android:textColor="#111827"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/buttonRefreshUsbAlbum"
                    android:layout_width="72dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_ui_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/action_refresh_usb_album"
                    android:textColor="#374151"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textUsbAlbumHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/text_usb_camera_album_hint"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textUsbSelectedMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ui_status_capsule"
                android:padding="10dp"
                android:text="@string/text_usb_selected_media_empty"
                android:textColor="#111827"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ui_status_capsule">

                <ImageView
                    android:id="@+id/imageUsbMediaPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/content_usb_image_preview"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <VideoView
                    android:id="@+id/videoUsbMediaPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/content_usb_video_preview"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textUsbVideoHudOverlay"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glasses_hud_overlay"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <android.widget.GridLayout
                android:id="@+id/layoutUsbMediaTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutUsbAnnotationJsonPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ui_subpanel"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/title_usb_annotation_json"
                    android:textColor="#111827"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/buttonRefreshUsbJson"
                    android:layout_width="60dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_ui_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/action_refresh_usb_json"
                    android:textColor="#374151"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/buttonExportUsbJson"
                    android:layout_width="82dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_ui_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/action_export_usb_json"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textUsbAnnotationJsonHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/text_usb_annotation_json_hint"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textUsbSelectedJson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ui_status_capsule"
                android:padding="10dp"
                android:text="@string/text_usb_annotation_json_none_selected"
                android:textColor="#111827"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutUsbAnnotationJsonList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
