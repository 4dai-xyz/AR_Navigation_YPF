<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#FFF0EADF"
                android:startColor="#FFF8F5EE" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#2BD8DEE5" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#FFF5F0E6"
                android:startColor="#FFFFFEFC" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#24D5DBE3" />
        </shape>
    </item>
</selector>
